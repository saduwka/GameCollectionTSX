rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function publicProfile(uid) {
      return get(/databases/$(database)/documents/public_profiles/$(uid));
    }

    function isPublicProfile(uid) {
      return exists(/databases/$(database)/documents/public_profiles/$(uid))
        && publicProfile(uid).data.isPublic == true;
    }

    function validPublicProfile() {
      return request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'isPublic'])
        && request.resource.data.displayName is string
        && request.resource.data.photoURL is string
        && request.resource.data.isPublic is bool;
    }

    match /user_settings/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /public_profiles/{uid} {
      allow get: if isOwner(uid) || resource.data.isPublic == true;
      allow list: if false;
      allow create, update: if isOwner(uid) && validPublicProfile();
      allow delete: if isOwner(uid);
    }

    match /user_collections/{uid}/games/{gameId} {
      allow read: if isOwner(uid) || isPublicProfile(uid);
      allow create, update, delete: if isOwner(uid);
    }

    match /user_collections/{uid}/private/{gameId} {
      allow read, write: if isOwner(uid);
    }
  }
}
