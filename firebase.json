{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": {
    "site": "gamecollection-ff71a",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/sitemap.xml",
        "destination": "/sitemap-index.xml",
        "type": 301
      },
      {
        "source": "/sitemap-platforms.xml",
        "destination": "/sitemap-index.xml",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/spa.html"
      }
    ]
  }
}
